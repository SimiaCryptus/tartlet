{
  "name": "tartlet-monorepo",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter ./apps/* build",
    "typecheck": "tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "deno:smoke": "deno run --unstable-sloppy-imports --config deno.json scripts/deno-smoke.ts",
    "corpus:prompts": "node corpus/prompts/generate-prompts.mjs",
    "tartlet": "tsx packages/cli/src/main.ts",
    "corpus:classify": "tsx packages/cli/src/main.ts corpus corpus/runs",
    "cleanroom:log": "node scripts/log-session.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.13.0",
    "eslint-plugin-security": "^3.0.1",
    "fast-check": "^3.22.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.4"
  }
}